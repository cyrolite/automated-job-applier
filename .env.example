# ===================================================================
# job_applier configuration
# Copy to .env and fill in. .env is gitignored and never leaves your machine.
# ===================================================================

# --- Which model writes the tailored phrasing ---------------------
# anthropic : Claude via API. Best quality. Needs a key below.
# ollama    : a local model. No key, no cost, nothing leaves your machine.
# none      : no model. Bullets keep your original wording, re-ordered
#             for the role. Gap reports and documents still work.
JA_PROVIDER=anthropic

# --- Anthropic ----------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
# Paste it after the = with no quotes and no spaces.
ANTHROPIC_API_KEY=

# claude-sonnet-5-5 is the sensible default: fast, cheap, more than good
# enough here. Use claude-opus-5 for a role you really care about.
JA_MODEL=claude-sonnet-5-5

# --- Ollama (only if JA_PROVIDER=ollama) --------------------------
JA_OLLAMA_HOST=http://localhost:11434

# --- Document shaping ---------------------------------------------
JA_MAX_PAGES=1
JA_BULLETS_PER_ROLE=3
JA_MAX_TOKENS=8000
